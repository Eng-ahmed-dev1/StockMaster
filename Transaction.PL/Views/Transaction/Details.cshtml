@model TransactionReadProSupViewModels

@{
    ViewData["Title"] = "Transaction Details";
}

<link rel="stylesheet" href="~/css/TransactionDetails.css" />


<div class="details-container">
    <div class="details-card">
        <div class="details-header">
            <h1>Transaction Details</h1>
            <p>View detailed information about this transaction</p>
        </div>

        <div class="details-body">
            <div class="action-buttons">
                <a asp-action="Edit" asp-route-id="@Model?.TransactionId" class="btn-edit">
                    ✏️ Edit Transaction
                </a>
                <a asp-action="ShowAllTransactions" class="btn-back">
                    ← Back to List
                </a>
            </div>

            <div class="info-section">
                <div class="info-grid">
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.ProductName)</dt>
                        <dd>@Html.DisplayFor(model => model.ProductName)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.SupplierName)</dt>
                        <dd>@(Model?.SupplierName is not null ? Model.SupplierName : "User")</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.Quantity)</dt>
                        <dd>@Html.DisplayFor(model => model.Quantity)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.TransactionDate)</dt>
                        <dd>@Html.DisplayFor(model => model.TransactionDate)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.TransactionType)</dt>
                        <dd>@Html.DisplayFor(model => model.TransactionType)</dd>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
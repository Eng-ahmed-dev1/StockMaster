@model TransactionReadProSupViewModels

@{
    ViewData["Title"] = "Delete Transaction";
}

<link rel="stylesheet" href="~/css/DeleteTransaction.css" />


<div class="delete-container">
    <div class="delete-card">
        <div class="delete-header">
            <h1>Delete Transaction</h1>
            <p>Permanently remove this transaction from the system</p>
        </div>

        <div class="delete-body">
            <div class="warning-message">
                <span class="icon">⚠️</span>
                <span class="text">Are you sure you want to delete this transaction? This action cannot be undone.</span>
            </div>

            <div class="info-section">
                <div class="info-grid">
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.ProductName)</dt>
                        <dd>@Html.DisplayFor(model => model.ProductName)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.SupplierName)</dt>
                        <dd>@(Model?.SupplierName is not null ? Model.SupplierName : "User")</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.Quantity)</dt>
                        <dd>@Html.DisplayFor(model => model.Quantity)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.TransactionDate)</dt>
                        <dd>@Html.DisplayFor(model => model.TransactionDate)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.TransactionType)</dt>
                        <dd>@Html.DisplayFor(model => model.TransactionType)</dd>
                    </div>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="TransactionId" />
                <div class="action-buttons">
                    <button type="submit" class="btn-danger">
                        🗑️ Delete Transaction
                    </button>
                    <a asp-action="Index" class="btn-back">
                        ← Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
@model IEnumerable<TransactionReadProSupViewModels>
@{
    ViewData["Title"] = "All Transactions";
}

<link rel="stylesheet" href="~/css/ShowAllTransaction.css" />

<div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-receipt"></i>
        All Transactions
    </h1>
    <p class="page-subtitle">Manage and track all your business transactions</p>
</div>

<div class="stats-cards">
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-shopping-cart"></i>
        </div>
        <div class="stat-info">
            <h4 id="purchaseCount">0</h4>
            <p>Total Purchases</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-coins"></i>
        </div>
        <div class="stat-info">
            <h4 id="saleCount">0</h4>
            <p>Total Sales</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange">
            <i class="fas fa-exchange-alt"></i>
        </div>
        <div class="stat-info">
            <h4>@Model.Count()</h4>
            <p>All Transactions</p>
        </div>
    </div>
</div>

<div class="action-bar">
    <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" placeholder="Search transactions...">
    </div>
    <a asp-action="Create" class="btn-create">
        <i class="fas fa-plus-circle"></i>
        Create New Transaction
    </a>
</div>

<div class="table-container">
    @if (Model.Any())
    {
        <table class="custom-table" id="transactionsTable">
            <thead>
                <tr>
                    <th><i class="fas fa-box"></i> Product</th>
                    <th><i class="fas fa-user-tie"></i> Supplier</th>
                    <th><i class="fas fa-sort-numeric-up"></i> Quantity</th>
                    <th><i class="fas fa-calendar-alt"></i> Date</th>
                    <th><i class="fas fa-tag"></i> Type</th>
                    <th><i class="fas fa-cog"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="product-name">
                                <i class="fas fa-cube"></i>
                                @Html.DisplayFor(modelItem => item.ProductName)
                            </div>
                        </td>
                        <td>
                            @if (item.SupplierName is not null)
                            {
                                <span class="supplier-badge">
                                    <i class="fas fa-truck"></i> @item.SupplierName
                                </span>
                            }
                            else
                            {
                                <span class="user-badge">
                                    <i class="fas fa-user"></i> User
                                </span>
                            }
                        </td>
                        <td>
                            <span class="quantity-badge">
                                @Html.DisplayFor(modelItem => item.Quantity)
                            </span>
                        </td>
                        <td>
                            <i class="fas fa-calendar"></i>
                            @item.TransactionDate.ToString("MMM dd, yyyy")
                        </td>
                        <td>
                            @{
                                var transactionType = item.TransactionType.ToString().ToLower();
                                var badgeClass = transactionType == "purchase" ? "badge-purchase" :
                                transactionType == "sale" ? "badge-sale" : "badge-return";
                            }
                            <span class="badge-transaction @badgeClass">
                                @Html.DisplayFor(modelItem => item.TransactionType)
                            </span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.TransactionId" class="btn-action btn-edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.TransactionId" class="btn-action btn-details">
                                    <i class="fas fa-info-circle"></i> Details
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.TransactionId" class="btn-action btn-delete">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>No Transactions Found</h3>
            <p>Start by creating your first transaction</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Search functionality
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const searchValue = this.value.toLowerCase();
            const tableRows = document.querySelectorAll('#transactionsTable tbody tr');

            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchValue) ? '' : 'none';
            });
        });

        // Calculate statistics
        document.addEventListener('DOMContentLoaded', function() {
            const rows = document.querySelectorAll('#transactionsTable tbody tr');
            let purchaseCount = 0;
            let saleCount = 0;

            rows.forEach(row => {
                const typeCell = row.cells[4].textContent.toLowerCase().trim();
                if (typeCell.includes('purchase')) {
                    purchaseCount++;
                } else if (typeCell.includes('sale')) {
                    saleCount++;
                }
            });

            document.getElementById('purchaseCount').textContent = purchaseCount;
            document.getElementById('saleCount').textContent = saleCount;
        });
    </script>
}
@model IEnumerable<TransactionReadProSupViewModels>
@{
    ViewData["Title"] = "All Transactions";
}

<style>
    .page-header {
        background: #2c3e50;
        border-radius: 12px;
        padding: 35px 30px;
        margin-bottom: 2rem;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        color: white;
        border-bottom: 4px solid #3498db;
    }

    .page-title {
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 1rem;
        letter-spacing: -0.5px;
    }

        .page-title i {
            font-size: 2rem;
            color: #3498db;
        }

    .page-subtitle {
        margin: 8px 0 0 0;
        color: #bdc3c7;
        font-size: clamp(0.9rem, 2vw, 0.95rem);
        font-weight: 400;
    }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .btn-create {
        background: #3498db;
        color: white;
        padding: 13px 32px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
        box-shadow: 0 2px 8px rgba(52, 152, 219, 0.3);
        transition: all 0.2s ease;
        font-size: 0.95rem;
    }

        .btn-create:hover {
            background: #2980b9;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.4);
            color: white;
        }

        .btn-create:active {
            transform: translateY(0);
        }

    .search-box {
        position: relative;
        flex: 1;
        max-width: 400px;
    }

        .search-box input {
            width: 100%;
            padding: 11px 14px 11px 40px;
            border: 1px solid #dce1e6;
            border-radius: 6px;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            background: #fafbfc;
            color: #2c3e50;
        }

            .search-box input:focus {
                outline: none;
                border-color: #3498db;
                background: white;
                box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
            }

        .search-box i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #7f8c8d;
        }

    .table-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .custom-table {
        width: 100%;
        margin: 0;
    }

        .custom-table thead {
            background: #f5f7fa;
        }

            .custom-table thead th {
                padding: 18px 16px;
                font-weight: 600;
                color: #2c3e50;
                border: none;
                text-transform: uppercase;
                font-size: 0.8rem;
                letter-spacing: 0.5px;
            }

        .custom-table tbody tr {
            border-bottom: 1px solid #ecf0f1;
            transition: all 0.2s ease;
        }

            .custom-table tbody tr:hover {
                background: #f8f9fa;
            }

        .custom-table tbody td {
            padding: 18px 16px;
            vertical-align: middle;
            color: #2c3e50;
            font-size: 0.9rem;
        }

    .badge-transaction {
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.8rem;
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .badge-purchase {
        background: #d4edff;
        color: #2980b9;
    }

    .badge-sale {
        background: #d5f4e6;
        color: #27ae60;
    }

    .badge-return {
        background: #fff3cd;
        color: #f39c12;
    }

    .supplier-badge {
        background: #e8f4fd;
        color: #2980b9;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .user-badge {
        background: #fff3e0;
        color: #e67e22;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .product-name {
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .product-name i {
            color: #3498db;
        }

    .quantity-badge {
        background: #e8f5e9;
        color: #27ae60;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-block;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 8px 14px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.8rem;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border: none;
    }

    .btn-edit {
        background: #e8f4fd;
        color: #2980b9;
    }

        .btn-edit:hover {
            background: #2980b9;
            color: white;
            transform: translateY(-1px);
        }

    .btn-details {
        background: #f3e5f5;
        color: #8e44ad;
    }

        .btn-details:hover {
            background: #8e44ad;
            color: white;
            transform: translateY(-1px);
        }

    .btn-delete {
        background: #ffebee;
        color: #c0392b;
    }

        .btn-delete:hover {
            background: #c0392b;
            color: white;
            transform: translateY(-1px);
        }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #7f8c8d;
    }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 1rem;
            opacity: 0.4;
            color: #bdc3c7;
        }

        .empty-state h3 {
            color: #2c3e50;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .empty-state p {
            color: #7f8c8d;
        }

    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-2px);
        }

    .stat-icon {
        width: 55px;
        height: 55px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

        .stat-icon.blue {
            background: #e8f4fd;
            color: #2980b9;
        }

        .stat-icon.green {
            background: #e8f5e9;
            color: #27ae60;
        }

        .stat-icon.orange {
            background: #fff3e0;
            color: #e67e22;
        }

    .stat-info h4 {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .stat-info p {
        margin: 4px 0 0 0;
        color: #7f8c8d;
        font-size: 0.85rem;
        font-weight: 500;
    }

    media (max-width: 768px) {
        .page-header {
            padding: 25px 20px;
            border-radius: 8px;
        }

        .page-title {
            font-size: 1.4rem;
        }

            .page-title i {
                font-size: 1.5rem;
            }

        .page-subtitle {
            font-size: 0.85rem;
        }

        .action-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            max-width: 100%;
        }

        .table-container {
            overflow-x: auto;
        }

        .custom-table {
            min-width: 800px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn-action {
            justify-content: center;
        }

        .stats-cards {
            grid-template-columns: 1fr;
        }
    }

    media (max-width: 480px) {
        .page-header {
            padding: 20px 15px;
        }

        .page-title {
            font-size: 1.25rem;
        }

        .stat-card {
            padding: 20px;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
        }

        .stat-info h4 {
            font-size: 1.4rem;
        }
    }
</style>

<div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-receipt"></i>
        All Transactions
    </h1>
    <p class="page-subtitle">Manage and track all your business transactions</p>
</div>

<div class="stats-cards">
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-shopping-cart"></i>
        </div>
        <div class="stat-info">
            <h4 id="purchaseCount">0</h4>
            <p>Total Purchases</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-coins"></i>
        </div>
        <div class="stat-info">
            <h4 id="saleCount">0</h4>
            <p>Total Sales</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange">
            <i class="fas fa-exchange-alt"></i>
        </div>
        <div class="stat-info">
            <h4>@Model.Count()</h4>
            <p>All Transactions</p>
        </div>
    </div>
</div>

<div class="action-bar">
    <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" placeholder="Search transactions...">
    </div>
    <a asp-action="Create" class="btn-create">
        <i class="fas fa-plus-circle"></i>
        Create New Transaction
    </a>
</div>

<div class="table-container">
    @if (Model.Any())
    {
        <table class="custom-table" id="transactionsTable">
            <thead>
                <tr>
                    <th><i class="fas fa-box"></i> Product</th>
                    <th><i class="fas fa-user-tie"></i> Supplier</th>
                    <th><i class="fas fa-sort-numeric-up"></i> Quantity</th>
                    <th><i class="fas fa-calendar-alt"></i> Date</th>
                    <th><i class="fas fa-tag"></i> Type</th>
                    <th><i class="fas fa-cog"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="product-name">
                                <i class="fas fa-cube"></i>
                                @Html.DisplayFor(modelItem => item.ProductName)
                            </div>
                        </td>
                        <td>
                            @if (item.SupplierName is not null)
                            {
                                <span class="supplier-badge">
                                    <i class="fas fa-truck"></i> @item.SupplierName
                                </span>
                            }
                            else
                            {
                                <span class="user-badge">
                                    <i class="fas fa-user"></i> User
                                </span>
                            }
                        </td>
                        <td>
                            <span class="quantity-badge">
                                @Html.DisplayFor(modelItem => item.Quantity)
                            </span>
                        </td>
                        <td>
                            <i class="fas fa-calendar"></i>
                            @item.TransactionDate.ToString("MMM dd, yyyy")
                        </td>
                        <td>
                            @{
                                var transactionType = item.TransactionType.ToString().ToLower();
                                var badgeClass = transactionType == "purchase" ? "badge-purchase" :
                                transactionType == "sale" ? "badge-sale" : "badge-return";
                            }
                            <span class="badge-transaction @badgeClass">
                                @Html.DisplayFor(modelItem => item.TransactionType)
                            </span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.TransactionId" class="btn-action btn-edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.TransactionId" class="btn-action btn-details">
                                    <i class="fas fa-info-circle"></i> Details
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.TransactionId" class="btn-action btn-delete">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>No Transactions Found</h3>
            <p>Start by creating your first transaction</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Search functionality
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const searchValue = this.value.toLowerCase();
            const tableRows = document.querySelectorAll('#transactionsTable tbody tr');

            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchValue) ? '' : 'none';
            });
        });

        // Calculate statistics
        document.addEventListener('DOMContentLoaded', function() {
            const rows = document.querySelectorAll('#transactionsTable tbody tr');
            let purchaseCount = 0;
            let saleCount = 0;

            rows.forEach(row => {
                const typeCell = row.cells[4].textContent.toLowerCase().trim();
                if (typeCell.includes('purchase')) {
                    purchaseCount++;
                } else if (typeCell.includes('sale')) {
                    saleCount++;
                }
            });

            document.getElementById('purchaseCount').textContent = purchaseCount;
            document.getElementById('saleCount').textContent = saleCount;
        });
    </script>
}
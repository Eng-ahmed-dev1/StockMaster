@model IEnumerable<TransactionReadProSupViewModels>
@{
    ViewData["Title"] = "Transactions";
    var isAdmin = User.IsInRole("Admin");
    var pageTitle = isAdmin ? "All Transactions" : "My Transactions";
}

<link rel="stylesheet" href="~/css/ShowAllTransaction.css" />

<div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-receipt"></i>
        @pageTitle
    </h1>
    <p class="page-subtitle">
        @(isAdmin ? "Manage and track all business transactions" : "View and manage your transactions")
    </p>
</div>

<div class="stats-cards">
    <div class="stat-card">
        <div class="stat-icon blue">
            <i class="fas fa-arrow-down"></i> <!-- أيقونة للـ Inbound -->
        </div>
        <div class="stat-info">
            <h4 id="inboundCount">0</h4>
            <p>Total Inbound</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon red">
            <i class="fas fa-arrow-up"></i> <!-- أيقونة للـ Outbound -->
        </div>
        <div class="stat-info">
            <h4 id="outboundCount">0</h4>
            <p>Total Outbound</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange">
            <i class="fas fa-exchange-alt"></i>
        </div>
        <div class="stat-info">
            <h4>@Model.Count()</h4>
            <p>@(isAdmin ? "All Transactions" : "My Transactions")</p>
        </div>
    </div>
</div>

<div class="action-bar">
    <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" placeholder="Search transactions...">
    </div>
    <a asp-action="Create" class="btn-create">
        <i class="fas fa-plus-circle"></i>
        Create New Transaction
    </a>
</div>

<div class="table-container">
    @if (Model.Any())
    {
        <table class="custom-table" id="transactionsTable">
            <thead>
                <tr>
                    <!-- إضافة عمود Created By للـ Admin فقط -->
                    @if (isAdmin)
                    {
                        <th><i class="fas fa-user"></i> Created By</th>
                    }
                    <th><i class="fas fa-box"></i> Product</th>
                    <th><i class="fas fa-user-tie"></i> Supplier</th>
                    <th><i class="fas fa-sort-numeric-up"></i> Quantity</th>
                    <th><i class="fas fa-calendar-alt"></i> Date</th>
                    <th><i class="fas fa-tag"></i> Type</th>
                    <th><i class="fas fa-cog"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="product-name">
                                <i class="fas fa-cube"></i>
                                @Html.DisplayFor(modelItem => item.ProductName)
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.SupplierName))
                            {
                                <span class="supplier-badge">
                                    <i class="fas fa-truck"></i> @item.SupplierName
                                </span>
                            }
                            else
                            {
                                <span class="user-badge">
                                    <i class="fas fa-user"></i> User
                                </span>
                            }
                        </td>
                        <td>
                            <span class="quantity-badge @(item.TransactionType == TransactionType.Inbound ? "quantity-inbound" : "quantity-outbound")">
                                @Html.DisplayFor(modelItem => item.Quantity)
                            </span>
                        </td>
                        <td>
                            <i class="fas fa-calendar"></i>
                            @item.TransactionDate.ToString("MMM dd, yyyy")
                        </td>
                        <td>
                            @{
                                var transactionType = item.TransactionType.ToString().ToLower();
                                var badgeClass = transactionType == "inbound" ? "badge-inbound" : "badge-outbound";
                                var badgeText = transactionType == "inbound" ? "IN" : "OUT";
                            }
                            <span class="badge-transaction @badgeClass">
                                @badgeText
                            </span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a asp-action="Edit" asp-route-id="@item.TransactionId" class="btn-action btn-edit">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.TransactionId" class="btn-action btn-details">
                                    <i class="fas fa-info-circle"></i> Details
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.TransactionId" class="btn-action btn-delete">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>No Transactions Found</h3>
            <p>
                @(isAdmin ? "There are no transactions in the system yet." : "You haven't created any transactions yet.")
            </p>
            <a asp-action="Create" class="btn-create">
                <i class="fas fa-plus-circle"></i>
                Create Your First Transaction
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Search functionality
        document.getElementById('searchInput')?.addEventListener('keyup', function() {
            const searchValue = this.value.toLowerCase();
            const tableRows = document.querySelectorAll('#transactionsTable tbody tr');

            tableRows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchValue) ? '' : 'none';
            });
        });

        // Calculate statistics
        document.addEventListener('DOMContentLoaded', function() {
            const rows = document.querySelectorAll('#transactionsTable tbody tr');
            let inboundCount = 0;
            let outboundCount = 0;

            rows.forEach(row => {
                const typeCell = row.querySelector('.badge-transaction');
                if (typeCell && typeCell.textContent.includes('IN')) {
                    inboundCount++;
                } else if (typeCell && typeCell.textContent.includes('OUT')) {
                    outboundCount++;
                }
            });

            if (document.getElementById('inboundCount')) {
                document.getElementById('inboundCount').textContent = inboundCount;
            }

            if (document.getElementById('outboundCount')) {
                document.getElementById('outboundCount').textContent = outboundCount;
            }
        });
    </script>
}
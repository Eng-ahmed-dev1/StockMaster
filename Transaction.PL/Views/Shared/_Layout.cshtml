<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Transactions</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TransactionsTask.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container">
                <a class="navbar-brand" href="#">
                    <i class="fas fa-exchange-alt"></i>
                    Transactions
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-action="ShowAllTransactions" asp-controller="Transaction">
                                    <i class="fas fa-receipt"></i>
                                    Transactions
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-action="ShowAllSuppliers" asp-controller="Suppliers">
                                        <i class="fas fa-truck"></i>
                                        Suppliers
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-action="Show" asp-controller="Product">
                                        <i class="fas fa-box"></i>
                                        Products
                                    </a>
                                </li>
                            }
                        }
                        else
                        {

                            <li class="nav-item">
                                <a class="nav-link" asp-action="Login" asp-controller="Account">
                                    <i class="fas fa-sign-in-alt"></i>
                                    Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-action="Register" asp-controller="Account">
                                    <i class="fas fa-user-plus"></i>
                                    Register
                                </a>
                            </li>
                        }

                        <!-- Theme Toggle will be inserted here by JavaScript -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item profile-dropdown" id="profileDropdown">
                                <a href="#" class="nav-link profile-toggle" id="profileToggle">
                                    <div class="profile-avatar" id="userAvatar">
                                        @{
                                            var userInitial = "U";
                                            if (User.Identity?.Name != null)
                                            {
                                                userInitial = User.Identity.Name[0].ToString().ToUpper();
                                            }
                                        }
                                        @userInitial
                                    </div>
                                    <span id="userName">
                                        @User.Identity?.Name
                                    </span>
                                    <i class="fas fa-chevron-down ms-1"></i>
                                </a>

                                <!-- Profile Dropdown Menu -->
                                <div class="profile-dropdown-menu">
                                    <div class="profile-header">
                                        <div class="profile-avatar-large" id="profileAvatarLarge">
                                            @userInitial
                                        </div>
                                        <h5 id="profileName">@User.Identity?.Name</h5>
                                        <p id="profileEmail">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                                        <div id="profileRoles">
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <span class="user-role-badge role-admin">Admin</span>
                                            }
                                            else
                                            {
                                                <span class="user-role-badge role-user">Supplier</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="profile-info">
                                        <div class="profile-actions">
                                            <a asp-action="Profile" asp-controller="Account" class="btn btn-primary btn-sm">
                                                <i class="fas fa-user me-1"></i>View Profile
                                            </a>
                                            <a asp-action="ChangePassword" asp-controller="Account" class="btn btn-outline-secondary btn-sm">
                                                <i class="fas fa-key me-1"></i>Password
                                            </a>
                                        </div>

                                        <ul class="profile-links">
                                            <li>
                                                <a asp-action="Profile" asp-controller="Account">
                                                    <i class="fas fa-user-cog"></i>
                                                    Account Settings
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-action="ShowAllTransactions" asp-controller="Transaction">
                                                    <i class="fas fa-history"></i>
                                                    My Transactions
                                                </a>
                                            </li>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <li>
                                                    <a asp-action="ShowAllSuppliers" asp-controller="Suppliers">
                                                        <i class="fas fa-truck"></i>
                                                        Suppliers
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-action="Show" asp-controller="Product">
                                                        <i class="fas fa-box"></i>
                                                        Products
                                                    </a>
                                                </li>
                                            }
                                            <li>
                                                <form asp-action="Logout" asp-controller="Account" method="post" id="logoutForm">
                                                    <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;">
                                                        <i class="fas fa-sign-out-alt"></i>
                                                        Logout
                                                    </a>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p class="footer-text">
                    &copy; 2025 All rights reserved.
                    Developed By DevAhmed
                </p>
                <div class="footer-links">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">
                        <i class="fas fa-shield-alt"></i> Privacy
                    </a>
                    <a href="#">
                        <i class="fas fa-file-contract"></i> Terms
                    </a>
                    <a href="#">
                        <i class="fas fa-envelope"></i> Contact
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dark-mode.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Navigation active state
            const currentPath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll('.nav-link:not(.profile-toggle)');

            navLinks.forEach(link => {
                link.classList.remove('active');
            });

            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if (href) {
                    if (currentPath.includes('/supplier') && href.includes('Supplier')) {
                        link.classList.add('active');
                    } else if (currentPath.includes('/transaction') && href.includes('Transaction')) {
                        link.classList.add('active');
                    } else if (currentPath.includes('/product') && href.includes('Product')) {
                        link.classList.add('active');
                    } else if (currentPath.includes('/account/login') && href.includes('Login')) {
                        link.classList.add('active');
                    } else if (currentPath.includes('/account/register') && href.includes('Register')) {
                        link.classList.add('active');
                    }
                }
            });

            // Profile dropdown toggle
            const profileToggle = document.getElementById('profileToggle');
            const profileDropdown = document.getElementById('profileDropdown');

            if (profileToggle && profileDropdown) {
                profileToggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    profileDropdown.classList.toggle('open');
                });

                // Close dropdown when clicking outside
                document.addEventListener('click', function(e) {
                    if (!profileDropdown.contains(e.target)) {
                        profileDropdown.classList.remove('open');
                    }
                });
            }

            // Logout form submission
            document.getElementById('logoutForm')?.addEventListener('submit', function(e) {
                e.preventDefault();
                if (confirm('Are you sure you want to logout?')) {
                    this.submit();
                }
            });

            // Hide dropdown on window resize (for mobile)
            window.addEventListener('resize', function() {
                if (profileDropdown) {
                    profileDropdown.classList.remove('open');
                }
            });
        });

        // Add keyboard navigation support
        document.addEventListener('keydown', function(e) {
            const profileDropdown = document.getElementById('profileDropdown');
            if (e.key === 'Escape' && profileDropdown?.classList.contains('open')) {
                profileDropdown.classList.remove('open');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
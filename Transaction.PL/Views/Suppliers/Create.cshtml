@model RegisterViewModel
@{
    ViewData["Title"] = "Create Supplier";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .create-container {
        background: #f5f7fa;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
    }

    .form-header {
        background: #2c3e50;
        padding: 35px 30px;
        border-bottom: 4px solid #3498db;
    }

        .form-header h1 {
            margin: 0;
            font-size: clamp(1.5rem, 4vw, 1.8rem);
            font-weight: 600;
            color: white;
            letter-spacing: -0.5px;
        }

        .form-header p {
            margin: 8px 0 0 0;
            color: #bdc3c7;
            font-size: clamp(0.9rem, 2vw, 0.95rem);
            font-weight: 400;
        }

    .form-body {
        padding: 40px 35px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 24px;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            display: block;
            font-size: 0.9rem;
        }

    .form-control,
    textarea.form-control,
    select.form-control {
        border: 1px solid #dce1e6;
        border-radius: 6px;
        padding: 11px 14px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        width: 100%;
        display: block;
        background: #fafbfc;
        color: #2c3e50;
    }

        .form-control:focus,
        textarea.form-control:focus,
        select.form-control:focus {
            border-color: #3498db;
            background: white;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
            outline: none;
        }

    select.form-control {
        cursor: pointer;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    /* Password Wrapper */
    .password-wrapper {
        position: relative;
    }

        .password-wrapper .form-control {
            padding-right: 45px;
        }

    .toggle-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #7f8c8d;
        padding: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s ease;
    }

        .toggle-password:hover {
            color: #3498db;
        }

        .toggle-password .eye-icon {
            width: 20px;
            height: 20px;
        }

    /* Password Strength Indicator */
    .password-strength {
        margin-top: 8px;
    }

    .strength-bar {
        height: 4px;
        background: #e0e0e0;
        border-radius: 2px;
        overflow: hidden;
        margin-bottom: 5px;
    }

    .strength-fill {
        height: 100%;
        transition: all 0.3s ease;
        border-radius: 2px;
    }

        .strength-fill.weak {
            background: #e74c3c;
        }

        .strength-fill.good {
            background: #f39c12;
        }

        .strength-fill.strong {
            background: #27ae60;
        }

        .strength-fill.impossible {
            background: #8e44ad;
        }

    .strength-text {
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
    }

    .strength-fill.weak ~ .strength-text {
        color: #e74c3c;
    }

    .strength-fill.good ~ .strength-text {
        color: #f39c12;
    }

    .strength-fill.strong ~ .strength-text {
        color: #27ae60;
    }

    .strength-fill.impossible ~ .strength-text {
        color: #8e44ad;
    }

    .text-danger {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
        font-weight: 500;
    }

    .btn-primary {
        background: #3498db;
        border: none;
        border-radius: 6px;
        padding: 13px 32px;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.2s ease;
        width: 100%;
        margin-top: 10px;
        cursor: pointer;
        color: white;
    }

        .btn-primary:hover {
            background: #2980b9;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

    .back-link {
        text-align: center;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #ecf0f1;
    }

        .back-link a {
            color: #7f8c8d;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.9rem;
        }

            .back-link a:hover {
                color: #3498db;
            }

    .validation-summary {
        background: #fef5f5;
        border: 1px solid #f5c6cb;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 25px;
        font-size: 0.9rem;
        color: #721c24;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

    /* Mobile Phones - Portrait */
    @@media (max-width: 768px) {
        .create-container {
            padding: 20px 15px;
        }

        .form-card {
            border-radius: 8px;
        }

        .form-header {
            padding: 25px 20px;
        }

            .form-header h1 {
                font-size: 1.4rem;
            }

            .form-header p {
                font-size: 0.85rem;
            }

        .form-body {
            padding: 30px 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-control,
        textarea.form-control,
        select.form-control {
            padding: 10px 12px;
            font-size: 0.9rem;
        }

        .btn-primary {
            padding: 12px 24px;
        }

        .back-link {
            margin-top: 20px;
        }
    }

    /* Tablets */
    @@media (min-width: 769px) and (max-width: 1024px) {
        .create-container {
            padding: 35px 25px;
        }

        .form-body {
            padding: 35px 30px;
        }
    }

    /* Large Desktops */
    @@media (min-width: 1025px) {
        .form-card {
            max-width: 900px;
        }
    }

    /* Extra Small Devices */
    @@media (max-width: 480px) {
        .form-header {
            padding: 20px 15px;
        }

            .form-header h1 {
                font-size: 1.25rem;
            }

        .form-body {
            padding: 25px 15px;
        }

        .form-control,
        textarea.form-control,
        select.form-control {
            font-size: 16px; /* Prevents zoom on iOS */
        }
    }

</style>
<div class="create-container">
    <div class="form-card">
        <div class="form-header">
            <h1>Create New Supplier</h1>
            <p>Add a new supplier to your network</p>
        </div>

        <div class="form-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="UserName" class="control-label">Username</label>
                        <input asp-for="UserName" class="form-control" placeholder="Enter username" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FullName" class="control-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Email" class="control-label">Email Address</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="supplier@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PhoneNumber" class="control-label">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+20 123 456 7890" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Password" class="control-label">Password</label>
                        <div class="password-wrapper">
                            <input asp-for="Password" class="form-control" type="password" id="passwordField" placeholder="Enter password" />
                            <button type="button" class="toggle-password" id="togglePassword">
                                <svg class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                        <div class="password-strength" id="passwordStrength">
                            <div class="strength-bar">
                                <div class="strength-fill" id="strengthFill"></div>
                            </div>
                            <span class="strength-text" id="strengthText"></span>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="control-label">Confirm Password</label>
                        <div class="password-wrapper">
                            <input asp-for="ConfirmPassword" class="form-control" type="password" id="confirmPasswordField" placeholder="Re-enter password" />
                            <button type="button" class="toggle-password" id="toggleConfirmPassword">
                                <svg class="eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Address" class="control-label">Address</label>
                        <input asp-for="Address" class="form-control" placeholder="Enter address" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="City" class="control-label">City</label>
                        <input asp-for="City" class="form-control" placeholder="Enter city" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Country" class="control-label">Country</label>
                        <select asp-for="Country" class="form-control" placeholder="Enter country" asp-items="Html.GetEnumSelectList<CountryType>()" ></select>
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DateOfBirth" class="control-label">Date of Birth</label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Gender" class="control-label">Gender</label>
                    <select asp-for="Gender" class="form-control" asp-items="Html.GetEnumSelectList<Gender>()">
                        <option value="">Select Gender</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        Create Supplier
                    </button>
                </div>
            </form>

            <div class="back-link">
                <a asp-action="ShowAllSuppliers">
                    ← Back to Suppliers List
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Toggle Password Visibility
        function togglePasswordVisibility(toggleBtn, passwordField) {
            toggleBtn.addEventListener('click', function() {
                const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordField.setAttribute('type', type);

                // Toggle eye icon
                const eyeIcon = this.querySelector('.eye-icon');
                if (type === 'text') {
                    eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
                } else {
                    eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
                }
            });
        }

        // Password Strength Checker
        function checkPasswordStrength(password) {
            let strength = 0;
            const strengthText = document.getElementById('strengthText');
            const strengthFill = document.getElementById('strengthFill');

            if (password.length === 0) {
                strengthText.textContent = '';
                strengthFill.style.width = '0%';
                strengthFill.className = 'strength-fill';
                return;
            }

            // Length check
            if (password.length >= 8) strength += 1;
            if (password.length >= 12) strength += 1;

            // Contains lowercase
            if (/[a-z]/.test(password)) strength += 1;

            // Contains uppercase
            if (/[A-Z]/.test(password)) strength += 1;

            // Contains numbers
            if (/[0-9]/.test(password)) strength += 1;

            // Contains special characters
            if (/[^A-Za-z0-9]/.test(password)) strength += 1;

            // Update UI based on strength
            let strengthLevel = '';
            let strengthClass = '';
            let widthPercent = 0;

            if (strength <= 2) {
                strengthLevel = 'Weak';
                strengthClass = 'weak';
                widthPercent = 25;
            } else if (strength <= 4) {
                strengthLevel = 'Good';
                strengthClass = 'good';
                widthPercent = 50;
            } else if (strength <= 5) {
                strengthLevel = 'Strong';
                strengthClass = 'strong';
                widthPercent = 75;
            } else {
                strengthLevel = 'Impossible';
                strengthClass = 'impossible';
                widthPercent = 100;
            }

            strengthText.textContent = strengthLevel;
            strengthFill.style.width = widthPercent + '%';
            strengthFill.className = 'strength-fill ' + strengthClass;
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            const passwordField = document.getElementById('passwordField');
            const confirmPasswordField = document.getElementById('confirmPasswordField');
            const togglePassword = document.getElementById('togglePassword');
            const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');

            // Setup toggle buttons
            togglePasswordVisibility(togglePassword, passwordField);
            togglePasswordVisibility(toggleConfirmPassword, confirmPasswordField);

            // Setup password strength checker
            passwordField.addEventListener('input', function() {
                checkPasswordStrength(this.value);
            });
        });
    </script>
}
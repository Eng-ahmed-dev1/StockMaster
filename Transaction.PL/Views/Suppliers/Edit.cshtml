@model EditUser
@{
    ViewData["Title"] = "Edit Supplier";
}

<link rel="stylesheet" href="~/css/SupplierEdit.css" />

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="mb-4">
        <h2 class="mb-1 fw-bold text-dark">Edit Supplier</h2>
        <p class="text-muted mb-0">Update supplier information</p>
    </div>

    <!-- Form Card -->
    <div class="row">
        <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-4" role="alert"></div>

                        <input type="hidden" asp-for="SupplierId" />

                        <div class="row">
                            <!-- Supplier Name -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="SupplierName" class="form-label text-dark fw-semibold mb-2" style="font-size: 0.875rem;">
                                    Supplier Name
                                </label>
                                <input asp-for="SupplierName" class="form-control form-control-lg border-secondary"
                                       style="transition: all 0.2s ease;"
                                       placeholder="Enter supplier name" />
                                <span asp-validation-for="SupplierName" class="text-danger small d-block mt-1"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="SupplierEmail" class="form-label text-dark fw-semibold mb-2" style="font-size: 0.875rem;">
                                    Email Address
                                </label>
                                <input asp-for="SupplierEmail" class="form-control form-control-lg border-secondary"
                                       type="email"
                                       style="transition: all 0.2s ease;"
                                       placeholder="supplier@example.com" />
                                <span asp-validation-for="SupplierEmail" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-4">
                            <label asp-for="PhoneNumber" class="form-label text-dark fw-semibold mb-2" style="font-size: 0.875rem;">
                                Phone Number
                            </label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg border-secondary"
                                   style="transition: all 0.2s ease;"
                                   placeholder="+20 123 456 7890" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-dark px-4" style="transition: all 0.2s ease;">
                                <i class="fas fa-save me-2"></i>Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-light px-4" style="transition: all 0.2s ease;">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Text -->
            <div class="mt-3">
                <p class="text-muted small mb-0">
                    <i class="fas fa-info-circle me-1"></i>
                    Make sure all information is accurate before saving
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
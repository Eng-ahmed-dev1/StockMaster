@model UserViewModel
@{
    ViewData["Title"] = "Delete Supplier";
}

<link rel="stylesheet" href="~/css/SupplierDelete.css" />

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="mb-4">
        <h2 class="mb-1 fw-bold text-danger">Delete Supplier</h2>
        <p class="text-muted mb-0">Are you sure you want to delete this supplier?</p>
    </div>

    <!-- Warning Alert -->
    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
        <div>
            <strong>Warning!</strong> This action cannot be undone. All associated data will be permanently removed.
        </div>
    </div>

    <!-- Supplier Information Card -->
    <div class="row">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="p-4 border-bottom bg-light">
                        <div class="d-flex align-items-center">
                            <div class="avatar-circle-large me-4">
                                @(Model.FullName?.Substring(0, 1).ToUpper() ?? Model.UserName?.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <h5 class="mb-1 fw-semibold">@Html.DisplayFor(model => model.FullName)</h5>
                                <p class="text-muted mb-0">@@@Html.DisplayFor(model => model.UserName)</p>
                            </div>
                        </div>
                    </div>
                    <div class="p-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-5 py-2 text-muted fw-semibold" style="font-size: 0.875rem;">
                                Email Address
                            </dt>
                            <dd class="col-sm-7 py-2 text-dark">
                                @Html.DisplayFor(model => model.Email)
                            </dd>

                            <dt class="col-sm-5 py-2 text-muted fw-semibold" style="font-size: 0.875rem;">
                                Phone Number
                            </dt>
                            <dd class="col-sm-7 py-2">
                                <span class="font-monospace text-muted">@(Model.PhoneNumber ?? "N/A")</span>
                            </dd>

                            <dt class="col-sm-5 py-2 text-muted fw-semibold" style="font-size: 0.875rem;">
                                Status
                            </dt>
                            <dd class="col-sm-7 py-2">
                                @{
                                    var statusColor = Model.IsActive ? "success" : "danger";
                                    var statusText = Model.IsActive ? "Active" : "Inactive";
                                }
                                <span class="badge bg-@statusColor bg-opacity-10 text-@statusColor border border-@statusColor" style="font-weight: 500;">
                                    @statusText
                                </span>
                            </dd>

                            <dt class="col-sm-5 py-2 text-muted fw-semibold" style="font-size: 0.875rem;">
                                Created Date
                            </dt>
                            <dd class="col-sm-7 py-2 text-muted">
                                @Model.CreatedAt.ToString("MMM dd, yyyy")
                            </dd>

                            @if (Model.Transactions != null && Model.Transactions.Any())
                            {
                                <dt class="col-sm-5 py-2 text-muted fw-semibold" style="font-size: 0.875rem;">
                                    Total Transactions
                                </dt>
                                <dd class="col-sm-7 py-2">
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning" style="font-weight: 500;">
                                        @Model.Transactions.Count() Transactions
                                    </span>
                                </dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Delete Form -->
            <div class="mt-4">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4" style="transition: all 0.2s ease;">
                            <i class="fas fa-trash me-2"></i>Yes, Delete Supplier
                        </button>
                        <a asp-action="Index" class="btn btn-light px-4" style="transition: all 0.2s ease;">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
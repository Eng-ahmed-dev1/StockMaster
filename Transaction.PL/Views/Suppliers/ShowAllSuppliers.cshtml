@model IEnumerable<UserViewModel>
@{
    ViewData["Title"] = "Suppliers";
}

<link rel="stylesheet" href="~/css/SupplierIndex.css" />

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Suppliers</h2>
            <p class="text-muted mb-0">Manage your supplier network</p>
        </div>
        <a asp-action="Create" class="btn btn-dark px-4" style="transition: all 0.2s ease;">
            <i class="fas fa-plus me-2"></i>Add Supplier
        </a>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr class="border-bottom">
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Supplier Name
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Email
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Phone Number
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Status
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Created Date
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold text-end" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="align-middle" style="transition: all 0.15s ease;">
                                    <td class="px-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle me-3">
                                                @(item.FullName?.Substring(0, 1).ToUpper() ?? item.UserName?.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <span class="fw-semibold text-dark d-block">@Html.DisplayFor(modelItem => item.FullName)</span>
                                                <span class="text-muted small">@@@Html.DisplayFor(modelItem => item.UserName)</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-muted" style="font-size: 0.9rem;">@Html.DisplayFor(modelItem => item.Email)</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="font-monospace text-muted" style="font-size: 0.9rem;">
                                            @(item.PhoneNumber ?? "N/A")
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">
                                        @{
                                            var statusColor = item.IsActive ? "success" : "danger";
                                            var statusText = item.IsActive ? "Active" : "Inactive";
                                        }
                                        <span class="badge bg-@statusColor bg-opacity-10 text-@statusColor border border-@statusColor" style="font-weight: 500;">
                                            @statusText
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-muted" style="font-size: 0.9rem;">
                                            @item.CreatedAt.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-light me-1"
                                           style="transition: all 0.2s ease;">
                                            Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-light me-1"
                                           style="transition: all 0.2s ease;">
                                            Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-light text-danger"
                                           style="transition: all 0.2s ease;">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <p class="mb-3 fs-5">No suppliers found</p>
                                        <a asp-action="Create" class="btn btn-dark">
                                            <i class="fas fa-plus me-2"></i>Add Your First Supplier
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white border-top py-3">
                <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 0.875rem;">
                    <span>@Model.Count() suppliers total</span>
                    <span>Updated @DateTime.Now.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
        }
    </div>
</div>
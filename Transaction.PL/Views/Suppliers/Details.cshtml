@model UserViewModel
@{
    ViewData["Title"] = "Supplier Details";
}

<link rel="stylesheet" href="~/css/SupplierDetails.css" />

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Supplier Details</h2>
            <p class="text-muted mb-0">View complete supplier information</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-dark px-4" style="transition: all 0.2s ease;">
                <i class="fas fa-edit me-2"></i>Edit Supplier
            </a>
            <a asp-action="ShowAllSuppliers" class="btn btn-light px-4" style="transition: all 0.2s ease;">
                Back to List
            </a>
        </div>
    </div>

    <!-- Supplier Information Card -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-0">
                    <div class="p-4 border-bottom">
                        <div class="d-flex align-items-center">
                            <div class="avatar-circle-large me-4">
                                @(Model.FullName?.Substring(0, 1).ToUpper() ?? Model.UserName?.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <h5 class="mb-1 fw-semibold">@Html.DisplayFor(model => model.FullName)</h5>
                                <p class="text-muted mb-0">@@@Html.DisplayFor(model => model.UserName)</p>
                            </div>
                        </div>
                    </div>
                    <div class="p-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 py-3 info-row px-4 text-muted fw-semibold" style="font-size: 0.875rem; transition: all 0.15s ease;">
                                Email Address
                            </dt>
                            <dd class="col-sm-8 py-3 info-row px-4 text-dark" style="transition: all 0.15s ease;">
                                @Html.DisplayFor(model => model.Email)
                            </dd>

                            <dt class="col-sm-4 py-3 info-row px-4 text-muted fw-semibold" style="font-size: 0.875rem; transition: all 0.15s ease;">
                                Phone Number
                            </dt>
                            <dd class="col-sm-8 py-3 info-row px-4" style="transition: all 0.15s ease;">
                                <span class="font-monospace text-muted">@(Model.PhoneNumber ?? "N/A")</span>
                            </dd>

                            <dt class="col-sm-4 py-3 info-row px-4 text-muted fw-semibold" style="font-size: 0.875rem; transition: all 0.15s ease;">
                                Status
                            </dt>
                            <dd class="col-sm-8 py-3 info-row px-4" style="transition: all 0.15s ease;">
                                @{
                                    var statusColor = Model.IsActive ? "success" : "danger";
                                    var statusText = Model.IsActive ? "Active" : "Inactive";
                                }
                                <span class="badge bg-@statusColor bg-opacity-10 text-@statusColor border border-@statusColor" style="font-weight: 500;">
                                    @statusText
                                </span>
                            </dd>

                            <dt class="col-sm-4 py-3 info-row px-4 text-muted fw-semibold" style="font-size: 0.875rem; transition: all 0.15s ease;">
                                Gender
                            </dt>
                            <dd class="col-sm-8 py-3 info-row px-4 text-muted" style="transition: all 0.15s ease;">
                                @(Model.Gender?.ToString() ?? "Not Specified")
                            </dd>

                            <dt class="col-sm-4 py-3 info-row px-4 text-muted fw-semibold" style="font-size: 0.875rem; transition: all 0.15s ease;">
                                Created Date
                            </dt>
                            <dd class="col-sm-8 py-3 info-row px-4 text-muted" style="transition: all 0.15s ease;">
                                @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt")
                            </dd>

                            <dt class="col-sm-4 py-3 info-row px-4 text-muted fw-semibold" style="font-size: 0.875rem; transition: all 0.15s ease;">
                                Last Login
                            </dt>
                            <dd class="col-sm-8 py-3 info-row px-4 text-muted" style="transition: all 0.15s ease;">
                                @(Model.LastLoginDate?.ToString("MMMM dd, yyyy 'at' hh:mm tt") ?? "Never")
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Transactions Section -->
            @if (Model.Transactions != null && Model.Transactions.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="p-4 border-bottom">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-semibold">Transaction History</h5>
                                <span class="badge bg-dark bg-opacity-10 text-dark" style="font-weight: 500;">
                                    @Model.Transactions.Count() Transactions
                                </span>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr class="border-bottom">
                                        <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                            Product
                                        </th>
                                        <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                            Quantity
                                        </th>
                                        <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                            Date
                                        </th>
                                        <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                            Type
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Transactions)
                                    {
                                        <tr class="align-middle" style="transition: all 0.15s ease;">
                                            <td class="px-4 py-3 text-dark">
                                                @(item.Product?.ProductName ?? "N/A")
                                            </td>
                                            <td class="px-4 py-3 fw-semibold text-dark">
                                                @item.Quantity
                                            </td>
                                            <td class="px-4 py-3 text-muted" style="font-size: 0.9rem;">
                                                @item.TransactionDate.ToString("MMM dd, yyyy")
                                            </td>
                                            <td class="px-4 py-3">
                                                @{
                                                    var typeColor = item.TransactionType.ToString() == "Inbound" ? "success" : "danger";
                                                }
                                                <span class="badge bg-@typeColor bg-opacity-10 text-@typeColor border border-@typeColor" style="font-weight: 500;">
                                                    @item.TransactionType
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center">
                        <p class="text-muted mb-0">No transactions found for this supplier</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
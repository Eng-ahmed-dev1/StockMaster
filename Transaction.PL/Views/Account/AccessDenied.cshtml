@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_AcessDenied.cshtml";

}

<div class="access-denied-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-lg border-0 fade-in">
                    <div class="card-body text-center p-5">
                        <!-- Animated Lock Icon -->
                        <div class="lock-icon mb-4">
                            <i class="fas fa-shield-alt text-danger" style="font-size: 6rem; opacity: 0.9;"></i>
                        </div>

                        <!-- Error Code -->
                        <h1 class="display-1 text-danger fw-bold mb-0">403</h1>
                        <h2 class="h4 text-muted mb-4">Access Denied</h2>

                        <!-- Message -->
                        <p class="lead text-secondary mb-4">
                            Sorry, you don't have permission to access this resource.
                        </p>

                        <!-- Info Box -->
                        <div class="alert alert-light border border-warning" role="alert">
                            <i class="fas fa-info-circle text-warning me-2"></i>
                            <strong>Administrator Access Required</strong>
                            <p class="mb-0 mt-2 small text-muted">
                                This page is restricted to users with administrative privileges.
                            </p>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-action="ShowAllTransactions" asp-controller="Transaction"
                                   class="btn btn-primary btn-lg px-5">
                                    <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                                </a>
                            }
                            else
                            {
                                <a asp-action="Login" asp-controller="Account"
                                   class="btn btn-primary btn-lg px-5">
                                    <i class="fas fa-sign-in-alt me-2"></i>Login
                                </a>
                            }

                            <a asp-action="Profile" asp-controller="Account"
                               class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-user me-2"></i>My Profile
                            </a>
                        </div>

                        <!-- Help Text -->
                        <div class="mt-5 pt-4 border-top">
                            <p class="text-muted small mb-2">
                                <i class="fas fa-question-circle me-1"></i>
                                Need help? Contact support at
                                <a href="mailto:support@company.com">support@company.com</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
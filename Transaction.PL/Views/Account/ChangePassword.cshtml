@model Transaction.BLL.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <!-- Success Alert -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-check-circle fa-lg me-3"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="alert-heading mb-1">Success!</h5>
                            <p class="mb-0">@TempData["SuccessMessage"]</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            }

            <div class="card border-0 shadow-lg">
                <!-- Card Header -->
                <div class="card-header bg-gradient-primary text-white py-4 border-0">
                    <div class="d-flex align-items-center">
                        <div class="icon-container bg-white bg-opacity-25 rounded-circle p-3 me-3">
                            <i class="fas fa-key fa-2x"></i>
                        </div>
                        <div>
                            <h1 class="h3 mb-1">Change Password</h1>
                            <p class="mb-0 opacity-75">Update your account password securely</p>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4 p-md-5">
                    <!-- Validation Summary -->
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                <div>
                                    <h6 class="alert-heading mb-1">Please fix the following errors:</h6>
                                    <div asp-validation-summary="All" class="mb-0 small"></div>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Requirements Card -->
                    <div class="card border-info mb-4 bg-info bg-opacity-5">
                        <div class="card-body">
                            <h5 class="card-title text-info mb-3">
                                <i class="fas fa-shield-alt me-2"></i>Password Requirements
                            </h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <ul class="list-unstyled mb-0">
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-success me-2"></i>
                                            Minimum 8 characters
                                        </li>
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-success me-2"></i>
                                            Uppercase & lowercase letters
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <ul class="list-unstyled mb-0">
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-success me-2"></i>
                                            At least one number
                                        </li>
                                        <li class="mb-2">
                                            <i class="fas fa-check-circle text-success me-2"></i>
                                            Different from current
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Password Form -->
                    <form asp-action="ChangePassword" asp-controller="Account" method="post" id="changePasswordForm" class="needs-validation" novalidate>
                        <!-- Current Password -->
                        <div class="mb-4">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold">
                                <i class="fas fa-lock me-2"></i>Current Password
                            </label>
                            <div class="input-group">
                                <input asp-for="CurrentPassword"
                                       class="form-control form-control-lg border-end-0"
                                       placeholder="Enter your current password"
                                       id="currentPassword"
                                       autocomplete="current-password"
                                       required />
                                <span class="input-group-text bg-white border-start-0">
                                    <button type="button" class="btn btn-link text-secondary p-0 toggle-password" data-target="currentPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </span>
                            </div>
                            <div class="mt-2">
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- New Password -->
                        <div class="mb-4">
                            <label asp-for="NewPassword" class="form-label fw-semibold">
                                <i class="fas fa-key me-2"></i>New Password
                            </label>
                            <div class="input-group">
                                <input asp-for="NewPassword"
                                       class="form-control form-control-lg border-end-0"
                                       placeholder="Enter your new password"
                                       id="newPassword"
                                       autocomplete="new-password"
                                       required />
                                <span class="input-group-text bg-white border-start-0">
                                    <button type="button" class="btn btn-link text-secondary p-0 toggle-password" data-target="newPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </span>
                            </div>

                            <!-- Password Strength Meter -->
                            <div class="mt-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Password Strength</small>
                                    <small class="text-muted" id="strengthText">Weak</small>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div id="strengthBar"
                                         class="progress-bar"
                                         role="progressbar"
                                         style="width: 0%; transition: width 0.3s ease;">
                                    </div>
                                </div>
                            </div>

                            <div class="mt-2">
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-5">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">
                                <i class="fas fa-key me-2"></i>Confirm New Password
                            </label>
                            <div class="input-group">
                                <input asp-for="ConfirmNewPassword"
                                       class="form-control form-control-lg border-end-0"
                                       placeholder="Re-enter your new password"
                                       id="confirmPassword"
                                       autocomplete="new-password"
                                       required />
                                <span class="input-group-text bg-white border-start-0">
                                    <button type="button" class="btn btn-link text-secondary p-0 toggle-password" data-target="confirmPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </span>
                            </div>
                            <div class="mt-2">
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-primary btn-lg py-3">
                                <i class="fas fa-save me-2"></i>Update Password
                            </button>

                            <a asp-action="Profile" asp-controller="Account" class="btn btn-outline-secondary btn-lg py-3">
                                <i class="fas fa-arrow-left me-2"></i>Back to Profile
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light py-3 border-0">
                    <div class="text-center text-muted small">
                        <i class="fas fa-info-circle me-1"></i>
                        For security reasons, please log out from all devices after changing your password
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        }

        .icon-container {
            width: 64px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            border-radius: 1rem;
            overflow: hidden;
        }

        .card-header {
            border-radius: 1rem 1rem 0 0 !important;
        }

        .form-control:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 0.25rem rgba(118, 75, 162, 0.25);
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            transition: transform 0.2s;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(118, 75, 162, 0.3);
            }

        .progress {
            border-radius: 4px;
            background-color: #f8f9fa;
        }

        .progress-bar {
            border-radius: 4px;
        }

        .btn-link:focus {
            box-shadow: none;
        }

        .alert {
            border-radius: 0.75rem;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Toggle password visibility
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('data-target');
                const input = document.getElementById(targetId);
                const icon = this.querySelector('i');

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.className = 'fas fa-eye-slash';
                } else {
                    input.type = 'password';
                    icon.className = 'fas fa-eye';
                }
            });
        });

        // Password strength indicator
        const newPasswordInput = document.getElementById('newPassword');
        const strengthBar = document.getElementById('strengthBar');
        const strengthText = document.getElementById('strengthText');

        newPasswordInput?.addEventListener('input', function() {
            const password = this.value;
            let strength = 0;
            let width = 0;
            let color = '';
            let text = '';

            // Length check
            if (password.length >= 8) strength++;
            // Lowercase & uppercase check
            if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
            // Number check
            if (password.match(/[0-9]/)) strength++;
            // Special character check
            if (password.match(/[^a-zA-Z0-9]/)) strength++;

            // Determine strength level
            if (password.length === 0) {
                width = 0;
                text = 'Weak';
                color = '#dc3545';
            } else if (strength <= 1) {
                width = 25;
                text = 'Weak';
                color = '#dc3545';
            } else if (strength <= 2) {
                width = 50;
                text = 'Medium';
                color = '#ffc107';
            } else if (strength <= 3) {
                width = 75;
                text = 'Good';
                color = '#17a2b8';
            } else {
                width = 100;
                text = 'Strong';
                color = '#28a745';
            }

            // Update progress bar
            strengthBar.style.width = width + '%';
            strengthBar.style.backgroundColor = color;
            strengthText.textContent = text;
        });

        // Form validation
        document.getElementById('changePasswordForm')?.addEventListener('submit', function(e) {
            const form = this;

            if (!form.checkValidity()) {
                e.preventDefault();
                e.stopPropagation();
            }

            form.classList.add('was-validated');

            // Custom password match validation
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (newPassword !== confirmPassword) {
                e.preventDefault();
                const confirmInput = document.getElementById('confirmPassword');
                confirmInput.setCustomValidity("Passwords do not match");
                confirmInput.reportValidity();
            }
        });

        // Clear custom validation on input
        document.getElementById('confirmPassword')?.addEventListener('input', function() {
            this.setCustomValidity('');
        });
    </script>
}
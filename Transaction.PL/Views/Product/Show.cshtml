@model IEnumerable<ProductReadViewModel>
@{
    ViewData["Title"] = "Products";
}

<link rel="stylesheet" href="~/css/Show.css" />


<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Products</h2>
            <p class="text-muted mb-0">Manage your inventory</p>
        </div>
        <a asp-action="Create" class="btn btn-dark px-4" style="transition: all 0.2s ease;">
            <i class="fas fa-plus me-2"></i>Add Product
        </a>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr class="border-bottom">
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Product
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                SKU
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Price
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Stock
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Description
                            </th>
                            <th class="px-4 py-3 text-uppercase text-muted fw-semibold text-end" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="align-middle" style="transition: all 0.15s ease;">
                                    <td class="px-4 py-3">
                                        <span class="fw-semibold text-dark">@Html.DisplayFor(modelItem => item.ProductName)</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="font-monospace text-muted" style="font-size: 0.9rem;">@Html.DisplayFor(modelItem => item.SKU)</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="fw-semibold text-dark">$@Html.DisplayFor(modelItem => item.Price)</span>
                                    </td>
                                    <td class="px-4 py-3">
                                        @{
                                            var stockLevel = item.StockLevel;
                                            var statusColor = stockLevel > 50 ? "success" : (stockLevel > 20 ? "warning" : "danger");
                                        }
                                        <span class="badge bg-@statusColor bg-opacity-10 text-@statusColor border border-@statusColor" style="font-weight: 500;">
                                            @Html.DisplayFor(modelItem => item.StockLevel)
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-muted" style="font-size: 0.9rem;">
                                            @(item.Description?.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <a asp-action="Details" asp-route-id="@item.ProductId"
                                           class="btn btn-sm btn-light me-1"
                                           style="transition: all 0.2s ease;">
                                            Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.ProductId"
                                           class="btn btn-sm btn-light me-1"
                                           style="transition: all 0.2s ease;">
                                            Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.ProductId"
                                           class="btn btn-sm btn-light text-danger"
                                           style="transition: all 0.2s ease;">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <p class="mb-3 fs-5">No products found</p>
                                        <a asp-action="Create" class="btn btn-dark">
                                            <i class="fas fa-plus me-2"></i>Add Your First Product
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white border-top py-3">
                <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 0.875rem;">
                    <span>@Model.Count() products total</span>
                    <span>Updated @DateTime.Now.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
        }
    </div>
</div>
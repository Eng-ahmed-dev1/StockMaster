@model ProductEditViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<style>
    .form-control:focus {
        border-color: #495057;
        box-shadow: 0 0 0 0.2rem rgba(73, 80, 87, 0.1);
    }

    .btn:hover {
        transform: translateY(-1px);
    }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="mb-4">
        <h2 class="mb-1 fw-bold text-dark">Edit Product</h2>
        <p class="text-muted mb-0">Update product information</p>
    </div>

    <!-- Form Card -->
    <div class="row">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-4" role="alert"></div>

                        <input type="hidden" asp-for="ProductId" />

                        <!-- Price Field -->
                        <div class="mb-4">
                            <label asp-for="Price" class="form-label text-dark fw-semibold mb-2" style="font-size: 0.875rem;">
                                @Html.DisplayNameFor(model => model.Price)
                            </label>
                            <input asp-for="Price" class="form-control form-control-lg border-secondary"
                                   style="transition: all 0.2s ease;"
                                   placeholder="Enter price" />
                            <span asp-validation-for="Price" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Description Field -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label text-dark fw-semibold mb-2" style="font-size: 0.875rem;">
                                @Html.DisplayNameFor(model => model.Description)
                            </label>
                            <textarea asp-for="Description" class="form-control border-secondary"
                                      rows="5"
                                      style="transition: all 0.2s ease; resize: vertical;"
                                      placeholder="Enter product description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 pt-3 border-top">
                            <button type="submit" class="btn btn-dark px-4" style="transition: all 0.2s ease;">
                                Save Changes
                            </button>
                            <a asp-action="Show" class="btn btn-light px-4" style="transition: all 0.2s ease;">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Text -->
            <div class="mt-3">
                <p class="text-muted small mb-0">
                    <i class="fas fa-info-circle me-1"></i>
                    Make sure all information is accurate before saving
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model ProductReadViewModel
@{
    ViewData["Title"] = "Product Details";
}

<link rel="stylesheet" href="~/css/ProductDetails.css" />

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark">Product Details</h2>
            <p class="text-muted mb-0">View complete product information</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model?.ProductId" class="btn btn-dark px-4">
                Edit Product
            </a>
            <a asp-action="Show" class="btn btn-light px-4">
                Back to List
            </a>
        </div>
    </div>

    <!-- Product Information Card -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-0">
                    <div class="p-4 border-bottom">
                        <h5 class="mb-0 fw-semibold">Product Information</h5>
                    </div>
                    <div class="p-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 py-3 px-4 text-muted fw-semibold">
                                Product Name
                            </dt>
                            <dd class="col-sm-8 py-3 px-4 fw-semibold text-dark">
                                @Html.DisplayFor(model => model.ProductName)
                            </dd>

                            <dt class="col-sm-4 py-3 px-4 text-muted fw-semibold">
                                SKU
                            </dt>
                            <dd class="col-sm-8 py-3 px-4">
                                <span class="font-monospace text-muted">@Html.DisplayFor(model => model.SKU)</span>
                            </dd>

                            <dt class="col-sm-4 py-3 px-4 text-muted fw-semibold">
                                Price
                            </dt>
                            <dd class="col-sm-8 py-3 px-4 fw-semibold text-dark">
                                $@Html.DisplayFor(model => model.Price)
                            </dd>

                            <dt class="col-sm-4 py-3 px-4 text-muted fw-semibold">
                                Stock Level
                            </dt>
                            <dd class="col-sm-8 py-3 px-4">
                                @{
                                    var stockLevel = Model.StockLevel;
                                    var statusColor = stockLevel > 50 ? "success" : (stockLevel > 20 ? "warning" : "danger");
                                }
                                <span class="badge bg-@statusColor bg-opacity-10 text-@statusColor border border-@statusColor">
                                    @Html.DisplayFor(model => model.StockLevel) Units
                                </span>
                            </dd>

                            <dt class="col-sm-4 py-3 px-4 text-muted fw-semibold">
                                Description
                            </dt>
                            <dd class="col-sm-8 py-3 px-4 text-muted">
                                @Html.DisplayFor(model => model.Description)
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Transactions Section -->
            @if (Model.Transactions != null && Model.Transactions.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="p-4 border-bottom">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-semibold">Transaction History</h5>
                                <span class="badge bg-dark bg-opacity-10 text-dark">
                                    @Model.Transactions.Count() Transactions
                                </span>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr class="border-bottom">
                                        <th class="px-4 py-3 text-uppercase text-muted fw-semibold">
                                            Supplier
                                        </th>
                                        <th class="px-4 py-3 text-uppercase text-muted fw-semibold">
                                            Quantity
                                        </th>
                                        <th class="px-4 py-3 text-uppercase text-muted fw-semibold">
                                            Date
                                        </th>
                                        <th class="px-4 py-3 text-uppercase text-muted fw-semibold">
                                            Type
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Transactions)
                                    {
                                        <tr class="align-middle">
                                            <td class="px-4 py-3 text-dark">
                                                @if (!string.IsNullOrEmpty(item.SupplierName))
                                                {
                                                    <span class="supplier-info">
                                                        <i class="fas fa-user-tie me-2"></i>
                                                        @item.SupplierName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        <i class="fas fa-user me-2"></i>
                                                        No Supplier
                                                    </span>
                                                }
                                            </td>
                                            <td class="px-4 py-3 fw-semibold text-dark">
                                                @item.Quantity
                                            </td>
                                            <td class="px-4 py-3 text-muted">
                                                @item.TransactionDate.ToString("MMM dd, yyyy")
                                            </td>
                                            <td class="px-4 py-3">
                                                @{
                                                    var typeColor = item.TransactionType.ToString().ToLower() == "inbound" ? "success" : "danger";
                                                    var typeText = item.TransactionType.ToString().ToLower() == "inbound" ? "IN" : "OUT";
                                                }
                                                <span class="badge bg-@typeColor bg-opacity-10 text-@typeColor border border-@typeColor">
                                                    @typeText
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center">
                        <p class="text-muted mb-0">No transactions found for this product</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


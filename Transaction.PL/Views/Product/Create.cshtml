@model ProductCreateViewModel

@{
    ViewData["Title"] = "Create Product";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .create-container {
        background: #f5f7fa;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .form-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
    }

    .form-header {
        background: #2c3e50;
        padding: 35px 30px;
        border-bottom: 4px solid #3498db;
    }

        .form-header h1 {
            margin: 0;
            font-size: clamp(1.5rem, 4vw, 1.8rem);
            font-weight: 600;
            color: white;
            letter-spacing: -0.5px;
        }

        .form-header p {
            margin: 8px 0 0 0;
            color: #bdc3c7;
            font-size: clamp(0.9rem, 2vw, 0.95rem);
            font-weight: 400;
        }

    .form-body {
        padding: 40px 35px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 24px;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
            display: block;
            font-size: 0.9rem;
        }

    .form-control,
    textarea.form-control {
        border: 1px solid #dce1e6;
        border-radius: 6px;
        padding: 11px 14px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        width: 100%;
        display: block;
        background: #fafbfc;
        color: #2c3e50;
    }

        .form-control:focus,
        textarea.form-control:focus {
            border-color: #3498db;
            background: white;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
            outline: none;
        }

    textarea.form-control {
        resize: vertical;
        min-height: 100px;
    }

    .text-danger {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
        font-weight: 500;
    }

    .btn-primary {
        background: #3498db;
        border: none;
        border-radius: 6px;
        padding: 13px 32px;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.2s ease;
        width: 100%;
        margin-top: 10px;
        cursor: pointer;
        color: white;
    }

        .btn-primary:hover {
            background: #2980b9;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

    .back-link {
        text-align: center;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #ecf0f1;
    }

        .back-link a {
            color: #7f8c8d;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.9rem;
        }

            .back-link a:hover {
                color: #3498db;
            }

    .validation-summary {
        background: #fef5f5;
        border: 1px solid #f5c6cb;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 25px;
        font-size: 0.9rem;
        color: #721c24;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
        }

    /* Mobile Phones - Portrait */
    media (max-width: 768px) {
        .create-container {
            padding: 20px 15px;
        }

        .form-card {
            border-radius: 8px;
        }

        .form-header {
            padding: 25px 20px;
        }

            .form-header h1 {
                font-size: 1.4rem;
            }

            .form-header p {
                font-size: 0.85rem;
            }

        .form-body {
            padding: 30px 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-control,
        textarea.form-control {
            padding: 10px 12px;
            font-size: 0.9rem;
        }

        .btn-primary {
            padding: 12px 24px;
        }

        .back-link {
            margin-top: 20px;
        }
    }

    /* Tablets */
    media (min-width: 769px) and (max-width: 1024px) {
        .create-container {
            padding: 35px 25px;
        }

        .form-body {
            padding: 35px 30px;
        }
    }

    /* Large Desktops */
    media (min-width: 1025px) {
        .form-card {
            max-width: 800px;
        }
    }

    /* Extra Small Devices */
   media (max-width: 480px) {
        .form-header {
            padding: 20px 15px;
        }

            .form-header h1 {
                font-size: 1.25rem;
            }

        .form-body {
            padding: 25px 15px;
        }

        .form-control,
        textarea.form-control {
            font-size: 16px; /* Prevents zoom on iOS */
        }
    }
</style>

<div class="create-container">
    <div class="form-card">
        <div class="form-header">
            <h1>Create New Product</h1>
            <p>Add a new product to your inventory system</p>
        </div>

        <div class="form-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="ProductName" class="control-label">Product Name</label>
                        <input asp-for="ProductName" class="form-control" placeholder="Enter product name" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="SKU" class="control-label">SKU</label>
                        <input asp-for="SKU" class="form-control" placeholder="e.g. PRD-001" />
                        <span asp-validation-for="SKU" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Price" class="control-label">Price</label>
                        <input asp-for="Price" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StockLevel" class="control-label">Stock Level</label>
                        <input asp-for="StockLevel" class="form-control" placeholder="Enter quantity" />
                        <span asp-validation-for="StockLevel" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description" class="control-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        Create Product
                    </button>
                </div>
            </form>

            <div class="back-link">
                <a asp-action="Show">
                    ← Back to Products List
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model ProductReadViewModel
@{
    ViewData["Title"] = "Delete Product";
}

<style>
    .delete-card:hover {
        box-shadow: 0 8px 25px rgba(231, 76, 60, 0.15);
    }

    .btn-danger:hover {
        background-color: #c0392b;
        border-color: #c0392b;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
    }

    .btn-secondary:hover {
        background-color: #5a6268;
        border-color: #545b62;
        transform: translateY(-2px);
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <!-- Alert Warning -->
            <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="fas fa-exclamation-triangle fs-3 me-3"></i>
                    <div>
                        <h5 class="alert-heading mb-1">Delete Confirmation</h5>
                        <p class="mb-0">Are you sure you want to delete this product? This action cannot be undone.</p>
                    </div>
                </div>
            </div>

            <!-- Product Details Card -->
            <div class="card border-0 shadow-sm delete-card" style="transition: all 0.3s ease;">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-box fs-4 me-2"></i>
                        <h4 class="mb-0">Product Details</h4>
                    </div>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted mb-3">
                            <i class="fas fa-tag me-2"></i>
                            @Html.DisplayNameFor(model => model.ProductName)
                        </dt>
                        <dd class="col-sm-8 mb-3 fw-semibold">
                            @Html.DisplayFor(model => model.ProductName)
                        </dd>

                        <dt class="col-sm-4 text-muted mb-3">
                            <i class="fas fa-barcode me-2"></i>
                            @Html.DisplayNameFor(model => model.SKU)
                        </dt>
                        <dd class="col-sm-8 mb-3">
                            <span class="badge bg-secondary">@Html.DisplayFor(model => model.SKU)</span>
                        </dd>

                        <dt class="col-sm-4 text-muted mb-3">
                            <i class="fas fa-dollar-sign me-2"></i>
                            @Html.DisplayNameFor(model => model.Price)
                        </dt>
                        <dd class="col-sm-8 mb-3 text-success fw-bold">
                            $@Html.DisplayFor(model => model.Price)
                        </dd>

                        <dt class="col-sm-4 text-muted mb-3">
                            <i class="fas fa-boxes me-2"></i>
                            @Html.DisplayNameFor(model => model.StockLevel)
                        </dt>
                        <dd class="col-sm-8 mb-3">
                            <span class="badge bg-info text-dark">@Html.DisplayFor(model => model.StockLevel) Units</span>
                        </dd>

                        <dt class="col-sm-4 text-muted mb-0">
                            <i class="fas fa-align-left me-2"></i>
                            @Html.DisplayNameFor(model => model.Description)
                        </dt>
                        <dd class="col-sm-8 mb-0">
                            @Html.DisplayFor(model => model.Description)
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-light border-0 p-4">
                    <form asp-action="Delete" class="d-flex gap-3 flex-wrap">
                        <input type="hidden" asp-for="ProductId" />
                        <button type="submit" class="btn btn-danger px-4 py-2" style="transition: all 0.3s ease;">
                            <i class="fas fa-trash-alt me-2"></i>
                            Confirm Delete
                        </button>
                        <a asp-action="Show" class="btn btn-secondary px-4 py-2" style="transition: all 0.3s ease;">
                            <i class="fas fa-arrow-left me-2"></i>
                            Cancel & Go Back
                        </a>
                    </form>
                </div>
            </div>

            <!-- Info Note -->
            <div class="mt-3 text-center">
                <small class="text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    Need help? <a href="#" class="text-decoration-none">Contact Support</a>
                </small>
            </div>
        </div>
    </div>
</div>
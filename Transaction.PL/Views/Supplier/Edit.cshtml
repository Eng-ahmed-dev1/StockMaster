@model SupplierEditViewModel

@{
    ViewData["Title"] = "Edit Supplier";
}
<link rel="stylesheet" href="~/css/EditSupplier.css" />


<div class="create-container">
    <div class="form-card">
        <div class="form-header">
            <h1>Edit Supplier</h1>
            <p>Update supplier information</p>
        </div>

        <div class="form-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

                <input type="hidden" asp-for="SupplierId" />

                <div class="form-row">
                    <div class="form-group full-width">
                        <label asp-for="SupplierName" class="control-label">Supplier Name</label>
                        <input asp-for="SupplierName" class="form-control" placeholder="Enter supplier name" />
                        <span asp-validation-for="SupplierName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="SupplierEmail" class="control-label">Email Address</label>
                        <input asp-for="SupplierEmail" class="form-control" placeholder="supplier@example.com" />
                        <span asp-validation-for="SupplierEmail" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PhoneNumber" class="control-label">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>
                </div>
            </form>

            <div class="back-link">
                <a asp-action="ShowSuppliers">
                    ← Back to Suppliers List
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
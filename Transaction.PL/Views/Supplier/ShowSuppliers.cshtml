@model IEnumerable<SupplierReadViewModel>
@{
    ViewData["Title"] = "Suppliers";
}

<link rel="stylesheet" href="~/css/ShowAllSupplier.css" />


<div class="list-container">
    <div class="content-wrapper">
        <div class="page-header">
            <h1 class="page-title">Suppliers</h1>
            <a asp-action="Create" class="btn-create">+ Create New Supplier</a>
        </div>

        <div class="table-card">
            @if (Model != null && Model.Any())
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.SupplierName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.SupplierEmail)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.PhoneNumber)
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SupplierName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SupplierEmail)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                                </td>
                                <td>
                                    <div class="action-links">
                                        <a asp-action="Edit" asp-route-id="@item.SupplierId">Edit</a>
                                        <a asp-action="Details" asp-route-id="@item.SupplierId">Details</a>
                                        <a asp-action="Delete" asp-route-id="@item.SupplierId">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <h3>No Suppliers Found</h3>
                    <p>Start by creating your first supplier</p>
                </div>
            }
        </div>
    </div>
</div>
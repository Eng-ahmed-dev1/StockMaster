@model IEnumerable<SupplierReadViewModel>
@{
    ViewData["Title"] = "Suppliers";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .list-container {
        background: #f5f7fa;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .content-wrapper {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        padding: 30px 35px;
        margin-bottom: 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .page-title {
        margin: 0;
        font-size: clamp(1.5rem, 4vw, 1.8rem);
        font-weight: 600;
        color: #2c3e50;
        letter-spacing: -0.5px;
    }

    .btn-create {
        background: #3498db;
        border: none;
        border-radius: 6px;
        padding: 12px 28px;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.2s ease;
        cursor: pointer;
        color: white;
        text-decoration: none;
        display: inline-block;
    }

        .btn-create:hover {
            background: #2980b9;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
            color: white;
        }

        .btn-create:active {
            transform: translateY(0);
        }

    .table-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

        .table thead {
            background: #2c3e50;
        }

            .table thead th {
                padding: 18px 20px;
                text-align: left;
                font-weight: 600;
                color: black;
                font-size: 0.9rem;
                letter-spacing: 0.3px;
                border-bottom: 4px solid #3498db;
            }

        .table tbody tr {
            border-bottom: 1px solid #ecf0f1;
            transition: background 0.2s ease;
        }

            .table tbody tr:hover {
                background: #f8f9fa;
            }

            .table tbody tr:last-child {
                border-bottom: none;
            }

        .table tbody td {
            padding: 16px 20px;
            color: #2c3e50;
            font-size: 0.95rem;
        }

    .action-links {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

        .action-links a {
            color: #7f8c8d;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
            font-size: 0.9rem;
        }

            .action-links a:hover {
                color: #3498db;
            }

            .action-links a:first-child:hover {
                color: #f39c12;
            }

            .action-links a:last-child:hover {
                color: #e74c3c;
            }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #7f8c8d;
    }

        .empty-state h3 {
            margin: 0 0 10px 0;
            font-size: 1.3rem;
            color: #95a5a6;
        }

        .empty-state p {
            margin: 0;
            font-size: 0.95rem;
        }

    /* Mobile Phones - Portrait */
    media (max-width: 768px) {
        .list-container {
            padding: 20px 15px;
        }

        .page-header {
            padding: 20px;
            flex-direction: column;
            align-items: stretch;
        }

        .page-title {
            font-size: 1.4rem;
            text-align: center;
        }

        .btn-create {
            width: 100%;
            text-align: center;
        }

        .table-card {
            overflow-x: auto;
        }

        .table {
            min-width: 600px;
        }

            .table thead th {
                padding: 14px 12px;
                font-size: 0.85rem;
            }

            .table tbody td {
                padding: 12px;
                font-size: 0.9rem;
            }

        .action-links {
            gap: 8px;
        }

            .action-links a {
                font-size: 0.85rem;
            }
    }

    /* Tablets */
    media (min-width: 769px) and (max-width: 1024px) {
        .list-container {
            padding: 35px 25px;
        }

        .page-header {
            padding: 25px 30px;
        }
    }

    /* Extra Small Devices */
    media (max-width: 480px) {
        .list-container {
            padding: 15px 10px;
        }

        .page-header {
            padding: 15px;
        }

        .page-title {
            font-size: 1.25rem;
        }

        .btn-create {
            padding: 10px 20px;
            font-size: 0.9rem;
        }

        .table {
            font-size: 0.85rem;
        }
    }
</style>

<div class="list-container">
    <div class="content-wrapper">
        <div class="page-header">
            <h1 class="page-title">Suppliers</h1>
            <a asp-action="Create" class="btn-create">+ Create New Supplier</a>
        </div>

        <div class="table-card">
            @if (Model != null && Model.Any())
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.SupplierName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.SupplierEmail)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.PhoneNumber)
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SupplierName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SupplierEmail)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                                </td>
                                <td>
                                    <div class="action-links">
                                        <a asp-action="Edit" asp-route-id="@item.SupplierId">Edit</a>
                                        <a asp-action="Details" asp-route-id="@item.SupplierId">Details</a>
                                        <a asp-action="Delete" asp-route-id="@item.SupplierId">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <h3>No Suppliers Found</h3>
                    <p>Start by creating your first supplier</p>
                </div>
            }
        </div>
    </div>
</div>
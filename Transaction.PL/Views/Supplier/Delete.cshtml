@model SupplierReadViewModel

@{
    ViewData["Title"] = "Delete Supplier";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .delete-container {
        background: #f5f7fa;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .delete-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
    }

    .delete-header {
        background: #e74c3c;
        padding: 35px 30px;
        border-bottom: 4px solid #c0392b;
    }

        .delete-header h1 {
            margin: 0;
            font-size: clamp(1.5rem, 4vw, 1.8rem);
            font-weight: 600;
            color: white;
            letter-spacing: -0.5px;
        }

        .delete-header p {
            margin: 8px 0 0 0;
            color: #fadbd8;
            font-size: clamp(0.9rem, 2vw, 0.95rem);
            font-weight: 400;
        }

    .delete-body {
        padding: 40px 35px;
    }

    .warning-message {
        background: #fff3cd;
        border: 2px solid #ffc107;
        border-radius: 8px;
        padding: 18px 20px;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .warning-message .icon {
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .warning-message .text {
            color: #856404;
            font-weight: 600;
            font-size: 1rem;
        }

    .info-section {
        margin-bottom: 35px;
    }

    .info-grid {
        display: grid;
        gap: 20px;
    }

    .info-item {
        background: #fafbfc;
        border: 1px solid #dce1e6;
        border-radius: 8px;
        padding: 18px 20px;
    }

        .info-item dt {
            font-weight: 600;
            color: #7f8c8d;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .info-item dd {
            margin: 0;
            font-size: 1.1rem;
            color: #2c3e50;
            font-weight: 500;
        }

    .action-buttons {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 2px solid #ecf0f1;
    }

    .btn-danger {
        background: #e74c3c;
        border: none;
        border-radius: 6px;
        padding: 13px 32px;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.2s ease;
        cursor: pointer;
        color: white;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-danger:hover {
            background: #c0392b;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
        }

        .btn-danger:active {
            transform: translateY(0);
        }

    .btn-back {
        background: #ecf0f1;
        color: #2c3e50;
        border: none;
        border-radius: 6px;
        padding: 13px 32px;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.2s ease;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-back:hover {
            background: #d5dbdb;
        }

    /* Mobile Phones - Portrait */
    media (max-width: 768px) {
        .delete-container {
            padding: 20px 15px;
        }

        .delete-card {
            border-radius: 8px;
        }

        .delete-header {
            padding: 25px 20px;
        }

            .delete-header h1 {
                font-size: 1.4rem;
            }

            .delete-header p {
                font-size: 0.85rem;
            }

        .delete-body {
            padding: 30px 20px;
        }

        .warning-message {
            padding: 15px;
            flex-direction: column;
            text-align: center;
        }

            .warning-message .icon {
                font-size: 2rem;
            }

        .action-buttons {
            flex-direction: column;
        }

        .btn-danger,
        .btn-back {
            width: 100%;
            justify-content: center;
        }
    }

    /* Tablets */
    media (min-width: 769px) and (max-width: 1024px) {
        .delete-container {
            padding: 35px 25px;
        }

        .delete-body {
            padding: 35px 30px;
        }
    }

    /* Large Desktops */
    media (min-width: 1025px) {
        .delete-card {
            max-width: 800px;
        }
    }

    /* Extra Small Devices */
    media (max-width: 480px) {
        .delete-header {
            padding: 20px 15px;
        }

            .delete-header h1 {
                font-size: 1.25rem;
            }

        .delete-body {
            padding: 25px 15px;
        }

        .info-item {
            padding: 15px;
        }
    }
</style>

<div class="delete-container">
    <div class="delete-card">
        <div class="delete-header">
            <h1>Delete Supplier</h1>
            <p>Permanently remove this supplier from the system</p>
        </div>

        <div class="delete-body">
            <div class="warning-message">
                <span class="icon">⚠️</span>
                <span class="text">Are you sure you want to delete this supplier? This action cannot be undone.</span>
            </div>

            <div class="info-section">
                <div class="info-grid">
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.SupplierName)</dt>
                        <dd>@Html.DisplayFor(model => model.SupplierName)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.SupplierEmail)</dt>
                        <dd>@Html.DisplayFor(model => model.SupplierEmail)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.PhoneNumber)</dt>
                        <dd>@Html.DisplayFor(model => model.PhoneNumber)</dd>
                    </div>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="SupplierId" />
                <div class="action-buttons">
                    <button type="submit" class="btn-danger">
                        🗑️ Delete Supplier
                    </button>
                    <a asp-action="ShowSuppliers" class="btn-back">
                        ← Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
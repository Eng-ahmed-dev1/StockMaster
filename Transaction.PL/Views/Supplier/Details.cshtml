@model SupplierReadViewModel

@{
    ViewData["Title"] = "Supplier Details";
}

<link rel="stylesheet" href="~/css/DetailsSupplier.css" />


<div class="details-container">
    <div class="details-card">
        <div class="details-header">
            <h1>Supplier Details</h1>
            <p>View detailed information about this supplier</p>
        </div>

        <div class="details-body">
            <div class="action-buttons">
                <a asp-action="Edit" asp-route-id="@Model?.SupplierId" class="btn-edit">
                    ✏️ Edit Supplier
                </a>
                <a asp-action="ShowSuppliers" class="btn-back">
                    ← Back to List
                </a>
            </div>

            <div class="info-section">
                <div class="info-grid">
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.SupplierName)</dt>
                        <dd>@Html.DisplayFor(model => model.SupplierName)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.SupplierEmail)</dt>
                        <dd>@Html.DisplayFor(model => model.SupplierEmail)</dd>
                    </div>
                    <div class="info-item">
                        <dt>@Html.DisplayNameFor(model => model.PhoneNumber)</dt>
                        <dd>@Html.DisplayFor(model => model.PhoneNumber)</dd>
                    </div>
                </div>
            </div>

            @if (Model.Transactions.Any())
            {
                <div class="transactions-section">
                    <h2>Transaction History</h2>
                    <div class="table-container">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Transaction Date</th>
                                    <th>Transaction Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Transactions)
                                {
                                    <tr>
                                        <td data-label="Product">@(item.ProductName)</td>
                                        <td data-label="Quantity">@(item.Quantity)</td>
                                        <td data-label="Transaction Date">@(item.TransactionDate.ToString("dd/MM/yyyy"))</td>
                                        <td data-label="Transaction Type">@(item.TransactionType)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="no-transactions">
                    📋 No transactions available for this supplier
                </div>
            }
        </div>
    </div>
</div>